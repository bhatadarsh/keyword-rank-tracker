# Database
DATABASE_URL=sqlite:///./rank_tracker.db

# SERP API Provider
# Options: 'mock' (no key needed) | 'serpapi' (requires SERP_API_KEY)
SERP_PROVIDER=mock

# Your SerpApi.com API key — required when SERP_PROVIDER=serpapi
# Get one at: https://serpapi.com/manage-api-key
SERP_API_KEY=your_serpapi_key_here
