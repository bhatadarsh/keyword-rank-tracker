# Database configuration (SQLite for zero-config local dev, or PostgreSQL)
DATABASE_URL=sqlite:///./rank_tracker.db

# Default SERP Provider
# Options:
#   'free'    — 100% Zero-cost live search (DuckDuckGo Lite / SearXNG with smart fallback) [RECOMMENDED]
#   'mock'    — 100% Zero-cost offline deterministic simulation with cannibalization & competitor modeling
#   'serpapi' — Official Google SERP API (requires SERP_API_KEY)
SERP_PROVIDER=free

# Optional: Public or private SearXNG instance endpoint for FreeSerpProvider
# e.g., https://searx.be/search or your self-hosted instance
SEARXNG_URL=

# Your SerpApi.com API key — only required when SERP_PROVIDER=serpapi
# Get one at: https://serpapi.com/manage-api-key
SERP_API_KEY=

# Run one backend instance only. Startup settles scans interrupted by the previous process.
# Comma-separated browser origins. Wildcards are not accepted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost
